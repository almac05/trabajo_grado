# Plantilla de /opt/despacho/.env (EnvironmentFile de las unidades de systemd).
#
#   sudo install -o despacho -g despacho -m 600 /dev/null /opt/despacho/.env
#   sudo -u despacho nano /opt/despacho/.env
#
# Nunca versionar el archivo real ni copiarlo a S3. Formato: NOMBRE=valor, una
# variable por linea, sin espacios alrededor del "=". Lo leen systemd
# (EnvironmentFile=) y bash (". /opt/despacho/.env" en los ensayos manuales): la
# contrasena va entre comillas simples, REGISTEL_DB_PASSWORD='...', y no debe
# contener comillas simples.

# Base MySQL por el tunel SSH (tunel-ionos.service).
REGISTEL_DB_HOST=127.0.0.1
REGISTEL_DB_PORT=3306
# Usuario reco_proceso: SELECT en bd_montebello_rdw y _gps; escritura solo en
# bd_montebello_recomendaciones.
REGISTEL_DB_USER=
REGISTEL_DB_PASSWORD=

# S3: credenciales por el rol de la instancia (nunca claves aqui).
PILOTO_S3_BUCKET=registel-montebello-despacho
PILOTO_S3_PREFIJO=piloto

# SNS: ARN del tema alertas-tesis (arn:aws:sns:us-east-2:<cuenta>:alertas-tesis).
PILOTO_SNS_TOPIC=
# 1 = aviso corto por SNS tambien cuando la corrida termina OK.
PILOTO_AVISAR_OK=1
