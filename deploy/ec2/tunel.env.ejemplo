# Plantilla de /opt/despacho/tunel.env (EnvironmentFile de tunel-ionos.service).
# No contiene secretos (la llave esta en /opt/despacho/.ssh/tunel_ionos), pero el
# destino no se versiona porque el repositorio es publico.
#
#   sudo install -o despacho -g despacho -m 640 /dev/null /opt/despacho/tunel.env
#
# Formato: usuario@host del VPS de IONOS.
PILOTO_TUNEL_DESTINO=
