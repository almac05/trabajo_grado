# Finales de linea normalizados a LF en el repositorio; los scripts de Windows
# conservan CRLF. No se renormalizo el repositorio al agregar este archivo.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

