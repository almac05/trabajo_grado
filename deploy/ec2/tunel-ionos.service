# Tunel SSH a la base MySQL del VPS de IONOS: 127.0.0.1:3306 en la instancia.
#
# No se habilita: lo arranca despacho-nocturno.service (Requires=) y se detiene
# solo cuando el nocturno termina, por StopWhenUnneeded=yes. Por eso no tiene
# seccion [Install]. El nocturno no debe detenerlo con un ExecStopPost=/ExecStop=
# "systemctl stop": con After=tunel-ionos.service eso es un bloqueo mutuo (ver
# despacho-nocturno.service).
#
# El destino (usuario@host) esta en /opt/despacho/tunel.env, fuera del repositorio
# (ver tunel.env.ejemplo). La llave solo permite reenviar a 127.0.0.1:3306.

[Unit]
Description=Piloto: tunel SSH a MySQL de IONOS (127.0.0.1:3306)
After=network-online.target
Wants=network-online.target
StopWhenUnneeded=yes

[Service]
Type=simple
User=despacho
Group=despacho
EnvironmentFile=/opt/despacho/tunel.env
ExecStart=/usr/bin/ssh -i /opt/despacho/.ssh/tunel_ionos \
    -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/opt/despacho/.ssh/known_hosts \
    -N -L 3306:127.0.0.1:3306 ${PILOTO_TUNEL_DESTINO}
Restart=on-failure
RestartSec=30
