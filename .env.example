# =============================================================================
# Variables de entorno - Proyecto de Grado Montebello
# =============================================================================
#
# Uso:
#   1. Copiar este archivo como `.env`.
#   2. Reemplazar los valores de ejemplo por credenciales reales.
#   3. No versionar `.env`; solo `.env.example` debe quedar en Git.
#
# El ETL carga este archivo desde `src/proyecto_grado/etl/config.py`.
# Las credenciales se usan para conectar a las bases MySQL de Registel.

# -----------------------------------------------------------------------------
# Registel / MySQL
# -----------------------------------------------------------------------------
# Host o IP del servidor MySQL.
REGISTEL_DB_HOST=localhost

# Puerto del servicio MySQL.
REGISTEL_DB_PORT=3306

# Usuario con permisos de lectura sobre las bases operativa y GPS.
REGISTEL_DB_USER=usuario_registel

# Contrasena del usuario anterior.
REGISTEL_DB_PASSWORD=change_me

# Nota:
# El nombre de la base de datos no se define aqui porque el ETL recibe el esquema
# como argumento en tiempo de ejecucion. Actualmente usa esquemas como:
# - bd_montebello_rdw
# - bd_montebello_rdw_gps

# -----------------------------------------------------------------------------
# Opcionales / uso futuro
# -----------------------------------------------------------------------------
# Descomentar solo si se implementa persistencia en S3 o ejecucion cloud.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=proyecto-grado-montebello
# AWS_S3_PREFIX_RAW=raw/
# AWS_S3_PREFIX_PROCESSED=processed/

# Nivel de logs si se conecta en el futuro con la configuracion de logging.
# LOG_LEVEL=INFO
